<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_anomaly_type_list" model="ir.ui.view">
        <field name="name">hr.attendance.anomaly.type.list</field>
        <field name="model">hr.attendance.anomaly.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="severity"/>
                <field name="detection_mode"/>
                <field name="threshold_minutes" optional="show"/>
                <field name="last_error" optional="show" decoration-danger="last_error"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_anomaly_type_form" model="ir.ui.view">
        <field name="name">hr.attendance.anomaly.type.form</field>
        <field name="model">hr.attendance.anomaly.type</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reset_conditions" type="object"
                            string="Réinitialiser le code standard"
                            confirm="Remplacer la condition Python par le code standard de ce type ?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description fonctionnelle..."/>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <strong>Cette règle est en erreur et ne détecte plus rien</strong>
                        (depuis le <field name="last_error_date" readonly="1" class="d-inline"/>) :
                        <field name="last_error" readonly="1"/>
                        <button name="action_clear_error" type="object" class="btn-link"
                                string="Marquer comme corrigée"/>
                    </div>
                    <group>
                        <field name="detection_mode" widget="radio"/>
                        <field name="has_threshold" invisible="1"/>
                        <field name="threshold_minutes"
                               invisible="detection_mode != 'standard' or not has_threshold"/>
                    </group>
                    <div invisible="detection_mode != 'expert'" groups="base.group_system">
                        <separator string="Condition Python (mode expert)"/>
                        <field name="condition_code" widget="ace" options="{'mode': 'python'}"/>
                    </div>
                    <div class="text-muted" invisible="detection_mode != 'expert'" groups="!base.group_system">
                        Cette règle est écrite en Python : seul un administrateur peut la modifier.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_anomaly_type" model="ir.actions.act_window">
        <field name="name">Types d'anomalies</field>
        <field name="res_model">hr.attendance.anomaly.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>