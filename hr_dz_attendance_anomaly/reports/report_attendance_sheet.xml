<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_attendance_sheet" model="ir.actions.report">
        <field name="name">Feuille de présence</field>
        <field name="model">attendance.anomaly.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_dz_attendance_anomaly.report_attendance_sheet_document</field>
        <field name="report_file">hr_dz_attendance_anomaly.report_attendance_sheet_document</field>
        <field name="print_report_name">'Feuille de présence - %s' % (object.employee_id.name)</field>
        <field name="binding_model_id" ref="model_attendance_anomaly_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_attendance_sheet_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Feuille de présence</h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Employé :</strong> <span t-field="o.employee_id.name"/><br/>
                                <span t-if="o.employee_id.job_title">
                                    <strong>Poste :</strong> <span t-field="o.employee_id.job_title"/><br/>
                                </span>
                                <span t-if="o.employee_id.department_id">
                                    <strong>Département :</strong> <span t-field="o.employee_id.department_id.name"/><br/>
                                </span>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Période :</strong>
                                <span t-field="o.date_from"/> — <span t-field="o.date_to"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mb-3">
                            <tbody>
                                <tr>
                                    <td><strong>Jours ouvrables</strong></td>
                                    <td class="text-end"><span t-field="o.total_work_days"/></td>
                                    <td><strong>Présences</strong></td>
                                    <td class="text-end"><span t-field="o.total_present"/></td>
                                    <td><strong>Absences</strong></td>
                                    <td class="text-end"><span t-field="o.total_absent"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Retards</strong></td>
                                    <td class="text-end"><span t-field="o.total_late"/></td>
                                    <td><strong>Départs anticipés</strong></td>
                                    <td class="text-end"><span t-field="o.total_early_leave"/></td>
                                    <td><strong>Jours fériés</strong></td>
                                    <td class="text-end"><span t-field="o.total_holidays"/></td>
                                </tr>
                                <tr>
                                    <td><strong>H. prévues</strong></td>
                                    <td class="text-end"><span t-field="o.total_scheduled_hours" t-options="{'widget': 'float_time'}"/></td>
                                    <td><strong>H. travaillées</strong></td>
                                    <td class="text-end"><span t-field="o.total_worked_hours" t-options="{'widget': 'float_time'}"/></td>
                                    <td><strong>Écart</strong></td>
                                    <td class="text-end"><span t-field="o.delta_hours" t-options="{'widget': 'float_time'}"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Jour</th>
                                    <th>Statut</th>
                                    <th>Entrée</th>
                                    <th>Sortie</th>
                                    <th class="text-end">H. travaillées</th>
                                    <th class="text-end">H. prévues</th>
                                    <th class="text-end">Retard (min)</th>
                                    <th class="text-end">Départ ant. (min)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.date"/></td>
                                    <td><span t-field="line.dayofweek_label"/></td>
                                    <td>
                                        <span t-if="line.status == 'present'">Présent</span>
                                        <span t-if="line.status == 'anomaly'">Anomalie</span>
                                        <span t-if="line.status == 'absent'">Absent</span>
                                        <span t-if="line.status == 'holiday'">
                                            Férié<t t-if="line.holiday_name"> — <span t-field="line.holiday_name"/></t>
                                        </span>
                                    </td>
                                    <td><span t-field="line.check_in" t-options="{'widget': 'datetime'}"/></td>
                                    <td><span t-field="line.check_out" t-options="{'widget': 'datetime'}"/></td>
                                    <td class="text-end"><span t-field="line.worked_hours" t-options="{'widget': 'float_time'}"/></td>
                                    <td class="text-end"><span t-field="line.scheduled_hours" t-options="{'widget': 'float_time'}"/></td>
                                    <td class="text-end"><span t-field="line.late_minutes"/></td>
                                    <td class="text-end"><span t-field="line.early_leave_minutes"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
