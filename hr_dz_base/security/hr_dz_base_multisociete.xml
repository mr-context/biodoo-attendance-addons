<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-société : chacun ne voit que les enregistrements des sociétés
         qu'il a sélectionnées ; sans société = partagé entre toutes. -->
    <record id="rule_hr_legal_parameter_company" model="ir.rule">
        <field name="name">Paramètres légaux : sociétés de l'utilisateur</field>
        <field name="model_id" ref="model_hr_legal_parameter"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
