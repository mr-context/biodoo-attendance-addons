<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Politique de présence ──────────────────────────────────────────── -->
    <record id="hr_attendance_policy_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.policy.list</field>
        <field name="model">hr.attendance.policy</field>
        <field name="arch" type="xml">
            <list string="Politiques de présence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="summary"/>
                <field name="is_company_default" string="Par défaut" widget="boolean"/>
                <field name="employee_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="hr_attendance_policy_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.policy.form</field>
        <field name="model">hr.attendance.policy</field>
        <field name="arch" type="xml">
            <form string="Politique de présence">
                <sheet>
                    <widget name="web_ribbon" title="Archivée" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Politique atelier"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        <field name="summary" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Retards et départs : application">
                            <field name="mode" widget="radio" nolabel="1" colspan="2"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_company_default" invisible="not is_company_default"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Absences">
                            <field name="absence_mode" widget="radio"/>
                            <field name="absence_after_days"/>
                            <field name="missing_punch_rule" widget="radio"/>
                        </group>
                        <group string="Heures supplémentaires">
                            <div class="text-muted" colspan="2">
                                Seuils, taux, nuits, jours de repos et validation : voir les
                                <button name="%(hr_attendance.hr_attendance_overtime_ruleset_action)d"
                                        type="action" string="règles d'heures supplémentaires"
                                        class="btn-link p-0 align-baseline"/>
                                (affectées au contrat).
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Retards">
                            <field name="late_tolerance_minutes"/>
                            <field name="late_rule" widget="radio"/>
                            <field name="late_cost" widget="radio"
                                   invisible="late_rule != 'per_occurrence'"
                                   required="late_rule == 'per_occurrence'"/>
                            <field name="late_rounding_minutes" invisible="late_rule == 'none'"/>
                            <field name="late_cumul_period" widget="radio"
                                   invisible="late_rule != 'cumulative'"
                                   required="late_rule == 'cumulative'"/>
                            <field name="late_cumul_basis" widget="radio"
                                   invisible="late_rule != 'cumulative'"
                                   required="late_rule == 'cumulative'"/>
                            <field name="late_cumul_threshold"
                                   invisible="late_rule != 'cumulative'"/>
                            <field name="late_cumul_days"
                                   invisible="late_rule != 'cumulative'"/>
                        </group>
                        <group string="Départs anticipés">
                            <field name="early_tolerance_minutes"/>
                            <field name="early_rule" widget="radio"/>
                            <field name="early_cost" widget="radio"
                                   invisible="early_rule != 'per_occurrence'"
                                   required="early_rule == 'per_occurrence'"/>
                            <field name="early_rounding_minutes" invisible="early_rule == 'none'"/>
                        </group>
                    </group>
                    <group string="Récupérations" name="recovery">
                        <field name="recovery_enabled"/>
                    </group>
                    <div class="text-muted mb-3" invisible="recovery_enabled">
                        Désactivé : les jours de repos et les heures sup. travaillés sont
                        payés en heures supplémentaires, sans repos à rendre.
                    </div>
                    <group invisible="not recovery_enabled">
                        <group string="Ce qui ouvre droit à un repos">
                            <field name="recovery_rest_day_mode" widget="radio"/>
                            <field name="recovery_holiday_mode" widget="radio"/>
                            <field name="recovery_basis" widget="radio"/>
                            <field name="recovery_flat_threshold" widget="float_time"
                                   invisible="recovery_basis != 'flat'"/>
                        </group>
                        <group string="Quand le prendre">
                            <field name="recovery_validity" widget="radio"/>
                            <field name="recovery_validity_days"
                                   invisible="recovery_validity != 'days'"
                                   required="recovery_validity == 'days'"/>
                            <field name="recovery_expiry_action" widget="radio"
                                   invisible="recovery_validity == 'none'"/>
                            <field name="recovery_reminder_days"
                                   invisible="recovery_validity == 'none'"/>
                        </group>
                    </group>
                    <group invisible="not recovery_enabled">
                        <group string="Options avancées : heures sup. des jours ouvrés">
                            <field name="recovery_overtime_mode" widget="radio"/>
                            <field name="recovery_overtime_cap" widget="float_time"
                                   invisible="recovery_overtime_mode == 'paid'"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                Le taux des heures (150 %, 200 %…) se règle dans les
                                <button name="%(hr_attendance.hr_attendance_overtime_ruleset_action)d"
                                        type="action" string="règles d'heures supplémentaires"
                                        class="btn-link p-0 align-baseline"/>.
                                Une heure sup. précise peut toujours être traitée autrement
                                (fiche de présence, colonne « Compensation »). Un repos pris
                                est un congé « Récupération » : payé, ni absence ni congé annuel.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employés affectés" name="employees">
                            <p class="text-muted">
                                Les employés de la société sans politique propre suivent la
                                politique par défaut de la société. Ajoutez ici ceux qui suivent
                                celle-ci à la place.
                            </p>
                            <field name="employee_ids" widget="many2many"
                                   context="{'default_attendance_policy_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="job_title"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_attendance_policy_action" model="ir.actions.act_window">
        <field name="name">Politiques de présence</field>
        <field name="res_model">hr.attendance.policy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer une politique de présence</p>
            <p>Une politique dit comment l'entreprise traite absences, sorties oubliées,
               retards et départs anticipés : à chaque fois, ou « 3 retards = 1 jour »,
               automatiquement ou après validation des RH.</p>
        </field>
    </record>

    <!-- ── Fiche employé : politique propre ───────────────────────────────── -->
    <record id="hr_employee_view_form_attendance_policy" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.policy</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" groups="hr.group_hr_user"
                     invisible="not dz_work_entry_error">
                    <strong>Prestations non recalculées</strong> :
                    <field name="dz_work_entry_error" readonly="1" class="d-inline"/>
                    — corriger la cause (contrat, horaire, pointages) ; le calcul de nuit réessaie.
                </div>
            </xpath>
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Pointage" name="attendance_policy">
                    <field name="attendance_policy_id"
                           placeholder="Politique de la société"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ── Heures sup. d'un pointage : compensation choisie par les RH ────── -->
    <record id="hr_attendance_view_form_dz_compensation" model="ir.ui.view">
        <field name="name">hr.attendance.form.dz.compensation</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='linked_overtime_ids']/list/field[@name='amount_rate']" position="after">
                <field name="dz_compensation" placeholder="Selon la politique"
                       groups="hr_attendance.group_hr_attendance_officer"/>
            </xpath>
        </field>
    </record>

    <!-- ── Société : politique par défaut (remplace les tolérances) ───────── -->
    <record id="view_company_form_attendance_policy" model="ir.ui.view">
        <field name="name">res.company.form.attendance.policy</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Pointage">
                    <field name="attendance_policy_id" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
