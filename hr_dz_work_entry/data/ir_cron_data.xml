<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Calcul de nuit : constate les absences (délai de la politique),
             rattrape les pointages arrivés en retard et recale les droits à
             récupération, du 1er du mois précédent à aujourd'hui. -->
        <record id="ir_cron_dz_work_entry_sync" model="ir.cron">
            <field name="name">Prestations : calcul de nuit</field>
            <field name="model_id" ref="model_hr_dz_work_entry_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_recent()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Récupérations : rappel avant échéance, puis traitement des repos
             non pris selon la politique (RH, payé ou perdu). -->
        <record id="ir_cron_dz_recovery_expiry" model="ir.cron">
            <field name="name">Récupérations : échéances</field>
            <field name="model_id" ref="model_hr_dz_recovery"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
